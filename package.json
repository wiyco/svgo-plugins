{
  "name": "svgo-plugins-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -b",
    "typecheck:tsc": "tsc -b",
    "typecheck:playground": "pnpm --filter ./apps/playground typecheck",
    "typecheck:playground:tsc": "pnpm --filter ./apps/playground typecheck:tsc",
    "dev:playground": "pnpm --filter ./apps/playground dev",
    "build": "pnpm -r build",
    "build:playground": "node ./scripts/build-playground.mjs",
    "generate:favicons:playground": "pnpm --filter ./apps/playground generate:favicons",
    "generate:og-images:playground": "pnpm --filter ./apps/playground generate:og-images",
    "preview:playground": "pnpm --filter ./apps/playground preview --host",
    "lint": "oxlint -c .oxlintrc.json .",
    "lint:fix": "oxlint -c .oxlintrc.json --fix .",
    "format": "oxfmt -c .oxfmtrc.json .",
    "format:check": "oxfmt -c .oxfmtrc.json --check .",
    "check": "pnpm run lint && pnpm run format:check",
    "check:fix": "pnpm run lint:fix && pnpm run format",
    "test": "vitest run",
    "test:browser:playground": "vitest run --config apps/playground/vitest.browser.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "all": "pnpm run typecheck && pnpm run check && pnpm run test:coverage"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "lefthook": "^2.2.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "publint": "^0.3.25",
    "tsdown": "0.23.1",
    "typescript": "^7.0.2",
    "vite": "8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.15.0"
}
